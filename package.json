{
  "name": "ua-jobs-scraper",
  "version": "1.0.0",
  "private": true,
  "description": "DOU + Djinni vacancies (Node.js / Fullstack / AI-LLM) -> vacancies.json",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "scrape": "tsx scrape-jobs.ts",
    "watch": "tsx watch.ts",
    "watch:dry": "tsx watch.ts --dry-run",
    "watch:test": "tsx watch.ts --test",
    "stack-stats": "tsx stack-stats.ts",
    "test": "tsx --test watch-filter.test.ts watch-app.test.ts stack-stats.test.ts",
    "typecheck": "tsc -p tsconfig.json"
  },
  "dependencies": {
    "cheerio": "^1.2.0",
    "dotenv": "^16.4.7",
    "grammy": "^1.31.0",
    "node-cron": "^3.0.3"
  },
  "devDependencies": {
    "@types/node": "^22.20.3",
    "@types/node-cron": "^3.0.11",
    "tsx": "^4.23.13",
    "typescript": "^7.0.2"
  }
}
